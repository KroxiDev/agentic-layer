{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kroxidev.dev/agentic/role-report.schema.json",
  "title": "RoleReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "attemptId",
    "acceptanceContractHash",
    "role",
    "completion",
    "decision",
    "findings",
    "evidence",
    "humanSummary"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "sessionId": { "type": "string", "minLength": 1 },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "acceptanceContractHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "role": {
      "enum": ["documentador", "evaluador", "explorador", "implementador", "planificador", "tester"]
    },
    "completion": { "enum": ["completed", "needs_input", "context_insufficient"] },
    "decision": { "enum": ["pass", "fail"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "classification",
          "severity",
          "criterionIds",
          "policyIds",
          "summary"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "classification": {
            "enum": [
              "acceptance_violation",
              "transversal_policy_violation",
              "novel_adversarial_finding",
              "informational"
            ]
          },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "criterionIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "policyIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "summary": { "type": "string", "pattern": "\\S" },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commandDigest", "expected", "observed"],
            "properties": {
              "commandDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "expected": { "type": "string", "pattern": "\\S" },
              "observed": { "type": "string", "pattern": "\\S" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "enum": [
                    "acceptance_violation",
                    "transversal_policy_violation",
                    "novel_adversarial_finding"
                  ]
                }
              },
              "required": ["classification"]
            },
            "then": { "required": ["reproduction"] }
          },
          {
            "if": {
              "properties": { "classification": { "const": "acceptance_violation" } },
              "required": ["classification"]
            },
            "then": { "properties": { "criterionIds": { "minItems": 1 } } }
          },
          {
            "if": {
              "properties": {
                "classification": { "const": "transversal_policy_violation" }
              },
              "required": ["classification"]
            },
            "then": { "properties": { "policyIds": { "minItems": 1 } } }
          },
          {
            "if": {
              "properties": { "classification": { "const": "novel_adversarial_finding" } },
              "required": ["classification"]
            },
            "then": {
              "properties": {
                "criterionIds": { "maxItems": 0 },
                "policyIds": { "maxItems": 0 }
              }
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "commandDigest", "exitCode", "durationMs"],
        "properties": {
          "kind": { "const": "command" },
          "commandDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "exitCode": { "type": "integer", "minimum": 0 },
          "durationMs": { "type": "number", "minimum": 0 }
        }
      }
    },
    "humanSummary": { "type": "string", "pattern": "\\S" },
    "missingContext": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "pass" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "evidence": {
            "items": {
              "properties": { "exitCode": { "const": 0 } }
            }
          },
          "findings": {
            "items": {
              "properties": {
                "classification": {
                  "not": {
                    "enum": ["acceptance_violation", "transversal_policy_violation"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": { "const": "fail" },
          "completion": { "not": { "const": "context_insufficient" } }
        },
        "required": ["decision", "completion"]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "classification": {
                  "enum": [
                    "acceptance_violation",
                    "transversal_policy_violation",
                    "novel_adversarial_finding"
                  ]
                }
              },
              "required": ["classification"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": { "completion": { "const": "context_insufficient" } },
        "required": ["completion"]
      },
      "then": {
        "required": ["missingContext"],
        "properties": { "decision": { "const": "fail" } }
      }
    },
    {
      "if": {
        "properties": { "completion": { "not": { "const": "context_insufficient" } } },
        "required": ["completion"]
      },
      "then": { "properties": { "missingContext": false } }
    }
  ]
}
