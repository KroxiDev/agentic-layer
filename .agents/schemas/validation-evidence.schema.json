{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kroxidev.dev/agentic/validation-evidence.schema.json",
  "title": "ValidationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "laneId",
    "generation",
    "treeFingerprint",
    "environmentFingerprint",
    "commands",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "laneId": { "type": "string", "pattern": "^full:[1-9][0-9]*$" },
    "generation": { "type": "integer", "minimum": 1 },
    "treeFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "environmentFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "exitCode", "durationMs"],
        "properties": {
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "exitCode": { "type": "integer", "minimum": 0 },
          "durationMs": { "type": "number", "minimum": 0 }
        }
      }
    },
    "decision": { "enum": ["pass", "fail"] }
  }
}
