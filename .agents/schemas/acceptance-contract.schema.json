{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kroxidev.dev/agentic/acceptance-contract.schema.json",
  "title": "AcceptanceContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "version",
    "userIntent",
    "nonGoals",
    "riskClass",
    "criteria",
    "transversalPolicies",
    "threatModel",
    "approval",
    "hash"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contractId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "userIntent": { "type": "string", "minLength": 1 },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "riskClass": { "type": "string", "minLength": 1 },
    "destructive": { "type": "boolean" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "oracle"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "oracle": { "type": "string", "minLength": 1 }
        }
      }
    },
    "transversalPolicies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "threatModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitPoints", "enumeratedFaults", "excludedFaults"],
      "properties": {
        "commitPoints": { "type": "array", "items": { "type": "string" } },
        "preCommitFailureSemantics": { "type": "string" },
        "postCommitFailureSemantics": { "type": "string" },
        "enumeratedFaults": { "type": "array", "items": { "type": "string" } },
        "excludedFaults": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
