      "path": ".agents/workflows/feature.md",
      "kind": "workflow",
      "markers": ["<!-- agentic-workflow -->", "<!-- agentic-light-sequence "]
    },
    {
      "path": ".agents/workflows/refactor.md",
      "kind": "workflow",
      "markers": ["<!-- agentic-workflow -->", "<!-- agentic-light-sequence "]
