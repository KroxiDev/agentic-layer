    },
    {
      "path": ".agents/roles/planificador.md",
      "kind": "role",
      "markers": ["<!-- agentic-role-report -->"]
    },
    {
      "path": ".agents/roles/tester.md",
      "kind": "role",
      "markers": ["<!-- agentic-role-report -->"]
