      "markers": ["<!-- agentic-role-report -->"]
    },
    {
      "path": ".agents/roles/evaluador.md",
      "kind": "role",
      "markers": ["<!-- agentic-role-report -->"]
    },
    {
      "path": ".agents/roles/explorador.md",
      "kind": "role",
      "markers": ["<!-- agentic-role-report -->"]
    },
    {
      "path": ".agents/roles/implementador.md",
