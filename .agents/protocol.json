    {
      "path": ".agents/skills/agentic-diagnostico-bugs/references/hitl-loop.template.ps1",
      "kind": "asset"
    },
    {
      "path": ".agents/skills/agentic-diagnostico-bugs/references/hitl-loop.template.sh",
      "kind": "asset"
    },
    { "path": ".agents/skills/agentic-grilling/SKILL.md", "kind": "skill" },
    { "path": ".agents/skills/agentic-tdd/SKILL.md", "kind": "skill" },
