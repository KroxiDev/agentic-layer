      "kind": "skill",
      "markers": ["<!-- agentic-protocol -->"]
    },
    {
      "path": ".agents/templates/dev-session.md",
      "kind": "template",
      "markers": ["<!-- agentic-template -->"]
    },
    {
      "path": ".agents/templates/subdev-session.md",
      "kind": "template",
      "markers": ["<!-- agentic-template -->"]
    },
    {
      "path": ".agents/workflows/architecture.md",
