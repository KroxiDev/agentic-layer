    {
      "path": ".codex/agents/documentador.toml",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".codex/agents/evaluador.toml",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".codex/agents/explorador.toml",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".codex/agents/implementador.toml",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".codex/agents/planificador.toml",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".codex/agents/tester.toml",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".claude/.gitignore",
      "source": ".claude/gitignore.asset",
      "kind": "asset"
    },
    {
      "path": ".claude/agents/documentador.md",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".claude/agents/evaluador.md",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".claude/agents/explorador.md",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".claude/agents/implementador.md",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".claude/agents/planificador.md",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".claude/agents/tester.md",
      "kind": "adapter",
      "markers": ["agentic-protocol"],
      "contains": ["RoleReport", "contextPaths"]
    },
    {
      "path": ".claude/skills/orquestar/SKILL.md",
      "kind": "adapter",
      "markers": ["<!-- agentic-protocol -->"],
      "contains": [".agents/kernel/orchestration-kernel.mjs", "WorkEnvelope", "RoleReport"]
    },
    {
      "path": "CLAUDE.md",
      "kind": "entrypoint",
      "markers": ["<!-- agentic-protocol -->"],
      "contains": [".agents/kernel/orchestration-kernel.mjs"]
    }
  ],
  "layerMarkers": [
    ".agents/policies/orquestacion.md",
    ".agents/skills/orquestar/SKILL.md",
    ".claude/skills/orquestar/SKILL.md",
    ".codex/agents/planificador.toml"
  ],
  "managedDirectories": [
    ".agents/conformance",
    ".agents/kernel",
    ".agents/policies",
    ".agents/roles",
    ".agents/schemas",
    ".agents/scripts",
    ".agents/skills",
    ".agents/templates",
    ".agents/workflows",
    ".claude/agents",
    ".claude/skills",
    ".codex/agents"
  ],
  "distributionSupportFiles": [
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "bin/agentic.mjs",
    "package.json",
    "scripts/agentic-init.mjs"
  ],
  "configuration": {
    "contextBudgetBytes": { "type": "integer", "minimum": 1, "default": 128000 },
    "telemetrySink": { "type": "string", "minLength": 1 }
  }
}
