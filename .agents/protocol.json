{
  "schemaVersion": 3,
  "distributionVersion": "0.2.0",
  "kernelInterface": ["apply", "inspect"],
  "artifacts": [
    { "path": ".agents/README.md", "kind": "documentation" },
    {
      "path": ".agents/conformance/protocol-conformance.mjs",
      "kind": "conformance",
      "contains": ["assertProtocolConformance"]
    },
    {
      "path": ".agents/kernel/adapters.mjs",
      "kind": "kernel",
      "markers": ["agentic-adapters"]
    },
    {
      "path": ".agents/kernel/orchestration-kernel.mjs",
      "kind": "kernel",
      "markers": ["agentic-kernel"]
    },
    {
      "path": ".agents/kernel/protocol-manifest.mjs",
      "kind": "kernel",
      "markers": ["agentic-protocol-manifest"]
    },
    {
      "path": ".agents/kernel/protocol.mjs",
      "kind": "kernel",
      "markers": ["agentic-protocol-core"]
    },
    {
      "path": ".agents/policies/orquestacion.md",
      "kind": "policy",
      "markers": ["<!-- agentic-protocol -->", "<!-- agentic-bootstrap-repair -->"]
    },
    { "path": ".agents/policies/regla-de-oro.md", "kind": "policy" },
    { "path": ".agents/policies/sdd-tdd.md", "kind": "policy" },
    { "path": ".agents/protocol.json", "kind": "manifest" },
    {
      "path": ".agents/roles/documentador.md",
